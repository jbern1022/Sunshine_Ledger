# Copy to .env and fill in real values. Docker Compose reads this file.

# --- Postgres/PostGIS ---
POSTGRES_USER=sunshine
POSTGRES_PASSWORD=sunshine_dev_only
POSTGRES_DB=sunshine_ledger
POSTGRES_PORT=5433
# Used by the backend container; host is the docker-compose service name.
DATABASE_URL=postgresql+psycopg://sunshine:sunshine_dev_only@db:5432/sunshine_ledger

# --- LegiScan (Florida state bills) ---
# Free tier: https://legiscan.com/legiscan (30,000 queries/month). Leave blank to use sample data.
LEGISCAN_API_KEY=
LEGISCAN_STATE=FL

# --- Legistar (Miami, Jacksonville local agendas) ---
# Legistar client tokens used in their public API base URL, e.g. https://webapi.legistar.com/v1/{client}
LEGISTAR_CLIENTS=miamifl,jaxcityc

# --- LLM summarization (Ollama on the Powerstation) ---
# Point this at your home-lab Ollama instance, e.g. http://powerstation.local:11434
# Must be bound to 0.0.0.0 (not just localhost) and reachable through the
# Windows Firewall if Ollama runs on a separate Windows machine.
# Observed the Powerstation's DHCP-leased IP change (192.168.4.48 ->
# 192.168.4.50) across a sleep/wake cycle -- if OLLAMA_HOST silently stops
# working, check its current IP before assuming Ollama itself is down.
# A DHCP reservation or mDNS hostname would avoid this.
# Model note: a 3B model (e.g. llama3.2) was unreliable at the who_it_affects
# task (missed obvious named beneficiary groups); an 8B Q4 model
# (llama3.1:8b) was consistently accurate in Step 2 gate testing.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- App ---
API_HOST=0.0.0.0
API_PORT=8010
FRONTEND_PORT=3010
# Must be reachable from your browser, not just from the docker host.
# Local Docker Desktop: http://localhost:8010
# Remote docker VM: http://<vm-lan-ip>:8010
NEXT_PUBLIC_API_URL=http://localhost:8010
# Optional: set to your docker host's LAN IP to silence the Next.js dev-mode
# cross-origin warning when accessing the app via that IP instead of localhost.
DEV_ORIGIN_HOST=
